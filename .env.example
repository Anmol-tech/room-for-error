# Copy to .env and fill in. Never commit .env.

# Director LLM: pick "openai" or "openrouter". Fill in the key for the one you use (or both).
LLM_PROVIDER=openai
# How long the model "thinks": none (fastest), low, medium, high
LLM_REASONING_EFFORT=none

# OpenRouter
OPENROUTER_API_KEY=
# Any OpenRouter model id that supports JSON output
OPENROUTER_MODEL=openai/gpt-5.5

# OpenAI (direct, works with the event credits)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna

# Vision model that finds clickable objects in scene images (must accept images).
# OpenAI: gpt-5.4-mini (fast, found every object in tests). OpenRouter: google/gemma-4-26b-a4b-it (cheapest) or google/gemini-3.8-flash
VISION_MODEL=gpt-5.4-mini

BFL_API_KEY=
BFL_MODEL=flux-3-image-klein

# Kane CLI (sign in once with: kane-cli login)
# KANE_HEADLESS=1          # hide the browser while Kane plays
# KANE_AUTO=0              # don't rehearse new adventures automatically
# KANE_REPORT=1            # send redacted run summaries via kanehack report
# KANE_APP_URL=http://localhost:5180
