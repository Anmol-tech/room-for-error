# Copy to .env and fill in. Never commit .env.

# Director LLM: pick "openai" or "openrouter". Fill in the key for the one you use (or both).
LLM_PROVIDER=openai
# How long the model "thinks": none (fastest), low, medium, high
LLM_REASONING_EFFORT=none

# OpenRouter
OPENROUTER_API_KEY=
# Any OpenRouter model id that supports JSON output
OPENROUTER_MODEL=openai/gpt-5.5

# OpenAI (direct, works with the event credits)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5

# Vision model that finds clickable objects in scene images (must accept images).
# Cheapest that tested well: google/gemma-4-26b-a4b-it. More accurate, ~15x the price: google/gemini-3.8-flash
VISION_MODEL=google/gemma-4-26b-a4b-it

BFL_API_KEY=
BFL_MODEL=flux-3-image-klein
